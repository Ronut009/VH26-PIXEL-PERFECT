DATABASE_PATH=data/alerts.db

# Ingest is a trust boundary: it is the endpoint that creates incidents, and a
# forged `resolved` alert closes a real one. Enabled by default; with no tokens
# configured, ingest refuses every request rather than falling open.
#
# Format: name:token[:scope], comma-separated. Scope is a prefix over
# `environment/cluster` and defaults to "*". Bind a staging sender to staging
# so a leaked staging token cannot silence production:
#
#   INGEST_TOKENS=prod-am:<token>:production/*,staging-am:<token>:staging/*
#
# Generate a token with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Senders present it as `Authorization: Bearer <token>` or `X-PulseGraph-Token`.
INGEST_AUTH_ENABLED=true
INGEST_TOKENS=local-dev:REPLACE-ME-WITH-A-RANDOM-TOKEN:*
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
SLACK_CHANNEL_ID=C0XXXXXXXXX
PAGERDUTY_INTEGRATION_KEY=REPLACE-ME
LOG_LEVEL=INFO
ENVIRONMENT=dev
OUTBOX_POLL_INTERVAL_MS=500
# Attempts a row may burn on its own faults. A channel outage parks rows
# without charging them, so an outage cannot dead-letter the backlog.
OUTBOX_MAX_ATTEMPTS=5

# Delivery circuit breaker: when to declare a channel down, how often to probe
# for its recovery, and how many real sends are trialled before trusting it.
OUTBOX_BREAKER_FAILURE_THRESHOLD=3
OUTBOX_PROBE_BASE_SECONDS=5
OUTBOX_PROBE_MAX_SECONDS=120
OUTBOX_HALF_OPEN_ALLOWANCE=3

# Adaptive batching ceilings, so a flapping alert cannot defer itself forever.
QUIET_WINDOW_MAX_MS=300000
INCIDENT_MAX_BATCH_SPAN_MS=600000

# Inbound callbacks — how a human acknowledging or resolving in Slack or
# PagerDuty reaches the incident. These endpoints are public, so an unset
# secret makes the matching route reject everything rather than trust anyone.
SLACK_SIGNING_SECRET=
PAGERDUTY_WEBHOOK_SECRET=

# Presumed resolution when alerts simply stop and nobody reports the fix.
# The threshold is a multiple of each incident's own EWMA gap, clamped between
# MIN and MAX; criticals are stretched by CRITICAL_MULTIPLIER / MULTIPLIER.
SILENCE_RESOLVE_ENABLED=true
SILENCE_RESOLVE_MULTIPLIER=6
SILENCE_RESOLVE_CRITICAL_MULTIPLIER=20
SILENCE_RESOLVE_MIN_MS=900000
SILENCE_RESOLVE_MAX_MS=21600000
SILENCE_SWEEP_INTERVAL_SECONDS=30

# GitHub App — configure read-only Metadata + Contents permissions only.
# Store actual secret values in your deployment secret manager, never Git.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
# Protect PulseGraph's repository mapping/snapshot APIs until dashboard auth exists.
GITHUB_ADMIN_TOKEN=
GITHUB_API_VERSION=2022-11-28
GITHUB_REQUEST_TIMEOUT_SECONDS=10
GITHUB_WEBHOOK_MAX_BYTES=1048576
GITHUB_WEBHOOK_MAX_REPOSITORIES=1000
GITHUB_MAX_TREE_ENTRIES=10000
GITHUB_MAX_TREE_REQUESTS=2000
GITHUB_MAX_TREE_DEPTH=64

# Bounded, in-memory GitHub source context and ephemeral patch-preview limits.
GITHUB_DIAGNOSIS_MAX_FILES=6
GITHUB_DIAGNOSIS_MAX_FILE_BYTES=8192
GITHUB_DIAGNOSIS_MAX_TOTAL_BYTES=49152
GITHUB_PATCH_MAX_FILES=8
GITHUB_PATCH_MAX_FILE_BYTES=32768
GITHUB_PATCH_MAX_TOTAL_BYTES=98304
GITHUB_PATCH_MAX_CHANGES=8
GITHUB_PATCH_MAX_BYTES=98304
GITHUB_PATCH_MAX_DIFF_BYTES=196608

# Optional local-only open-model diagnosis and patch proposals. Ollama is off
# unless explicitly enabled; this endpoint refuses non-loopback URLs.
OLLAMA_ENABLED=false
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_OUTPUT_TOKENS=2048

# Hosted diagnosis (tier 1) — for a cloud deployment with no local GPU.
# This sends bounded repository source to a third party, so it is gated on its
# own flag and not merely on an API key being present. When Ollama is enabled,
# local wins: source staying inside the deployment is the safer default.
ANTHROPIC_DIAGNOSIS_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_OUTPUT_TOKENS=16000
ANTHROPIC_TIMEOUT_SECONDS=60

# Email — the third hop of the failover chain, via any SMTP relay.
# Gmail: enable 2FA, then create an App Password (not the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM=
EMAIL_TO=

# Delivery worker identity and claim lease, so a second worker is safe to add.
OUTBOX_LEASE_SECONDS=60
OUTBOX_BATCH_SIZE=10
