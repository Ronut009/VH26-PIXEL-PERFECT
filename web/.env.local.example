# PulseGraph dashboard — server-side configuration.
#
# Both values are read ONLY by the Route Handlers under src/app/api/, which
# run on the Next.js server. Neither is prefixed with NEXT_PUBLIC_, so neither
# is inlined into the browser bundle. The browser talks exclusively to
# same-origin /api/* paths and never learns the backend's address.

# Origin of the FastAPI backend. Defaults to http://127.0.0.1:8000.
PULSEGRAPH_API_BASE=http://127.0.0.1:8000

# Bearer token for the backend's /v1/github/* management endpoints. It is
# attached server-side, inside the route handler, after the request has left
# the browser.
#
# SERVER-ONLY. Never rename this to NEXT_PUBLIC_GITHUB_ADMIN_TOKEN and never
# read it from a client component: that would ship a credential that
# authorizes repository metadata, snapshot, and diagnosis APIs to every
# visitor. Must match GITHUB_ADMIN_TOKEN in the backend's .env.
GITHUB_ADMIN_TOKEN=
